root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 8
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,yml}]
indent_size = 2
indent_style = space

[justfile]
indent_size = 4
indent_style = space

# The rip logs used as test fixtures are byte-for-byte what Exact Audio Copy
# wrote: UTF-16LE with CRLF line endings. Saving them with the settings above
# would silently change them.
[internal/riplog/testdata/*.log]
charset = utf-16le
end_of_line = crlf
insert_final_newline = unset
trim_trailing_whitespace = unset

# EAC writes cue sheets in the system's ANSI code page, so a title with an accent
# in it (as in bday.cue) is one byte that is not valid UTF-8. The test fixtures
# must stay exactly as EAC wrote them.
[internal/riplog/testdata/*.cue]
charset = latin1
end_of_line = crlf
insert_final_newline = unset
trim_trailing_whitespace = unset
